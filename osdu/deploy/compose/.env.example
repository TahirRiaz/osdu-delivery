# Copy to .env and set real values. Every secret lives here (or in your secret manager), never in the compose
# file or the images.

# SQL Server sa password (also used by the stack's connection strings). SQL Server enforces complexity.
MSSQL_SA_PASSWORD=

# HS256 signing key for control-plane tokens: at least 32 bytes of randomness.
SQLFLOW_JWT_SIGNING_KEY=

# Break-glass bootstrap secret: at least 32 bytes. Used once to provision users, then rotate or remove.
SQLFLOW_BOOTSTRAP_SECRET=

# The initial admin user bootstrap provisioning creates (password at least 12 characters).
SQLFLOW_ADMIN_USERNAME=admin
SQLFLOW_ADMIN_PASSWORD=

# The node's credential to the control plane: a personal access token minted with the `node` scope once the
# control plane is up (sign in as the admin, POST /api/v1/me/tokens with scopes ["node"], or the GUI's token
# page). Start the stack without the worker first, mint the token, set it here, then: docker compose up -d worker
SQLFLOW_NODE_TOKEN=

# Optional: the pool the worker service serves (empty = untargeted runs only).
SQLFLOW_WORKER_POOL=

# Optional: the git credentials a repository source naming none is read with, by the control plane's sync and the
# worker's checkouts. A GitHub App first (read-only, installed on the repository; sqlflow/docs/reference/guides/github-app.md): its client ID, and its
# private key as the base64 of its .pem file (one line), for a remote on github.com. Then a token, for any other remote.
SQLFLOW_GITHUB_APP_ID=
SQLFLOW_GITHUB_APP_PRIVATE_KEY=
SQLFLOW_GIT_TOKEN=

# The OSDU partition the stack delivers to, `dev` in docker-compose.yml (the partition the sample estate's flows
# name): the control plane registers it when it starts, with these values, which the runs bound to it resolve the
# flows' ${env:...} references with. It is not ready without a partition, so each one is required; the examples let
# the stack start and plan, and are replaced with your platform's before anything is delivered.
OSDU_URL=https://osdu.example.com
OSDU_TOKEN_URL=https://login.example.com/oauth2/v2.0/token
OSDU_SCOPE=api://osdu.example.com/.default
OSDU_CLIENT_ID=example-client-id

# Under whose access and legal terms the partition's records are delivered. The sample mappings fill acl.owners,
# acl.viewers and legal.legaltags from these, so one estate's documents serve every partition it runs against.
OSDU_ACL_OWNER=data.default.owners@dev.example.com
OSDU_ACL_VIEWER=data.default.viewers@dev.example.com
OSDU_LEGAL_TAG=dev-example-legal-tag

# The partition's client secret. The partition holds only the reference ${env:OSDU_CLIENT_SECRET}, which the
# control plane and the worker resolve from their own environment, so the secret never reaches the catalog or a run.
# A plan run needs none, so it can stay empty until a target exists.
OSDU_CLIENT_SECRET=
