output "gui_url" {
  description = "Sign in here with the bootstrap admin: admin_username, and the password the deployment generated into the vault (admin_password_secret)."
  value       = module.gui.gui_url
}

output "admin_password_secret" {
  description = "The vault secret holding the initial admin's password, generated by the deployment the first time: az keyvault secret show --vault-name <vault> --name <this> --query value -o tsv."
  value       = local.admin_password_secret_name
}

output "entra_client_id" {
  description = "Client id of the Entra registration users sign in with: created here when provision_entra_app is on, otherwise the azure_ad_client_id passed. Empty means SSO is off (local sign-in only)."
  value       = local.effective_entra_client
}

output "entra_redirect_uri" {
  description = "The GUI origin registered as the SPA redirect URI. Set on the registration here when provision_entra_app is on; in external mode add it yourself (Single-page application platform). Empty when SSO is off."
  value       = local.effective_entra_client == "" ? "" : module.gui.gui_url
}

output "entra_assignment_reminder" {
  description = "Next step for owned SSO: assignment is required, so no one can sign in until members are assigned."
  value       = (var.provision_entra_app && var.azure_ad_allowed_group_object_id == "") ? "Assign a group via azure_ad_allowed_group_object_id (or in the enterprise application) so members can sign in; assignment is required and none are assigned yet." : ""
}

output "entra_foreign_tenant_reminder" {
  description = "Next step for each tenant in azure_ad_additional_allowed_tenant_ids: an admin there must consent to the app and assign the SqlFlow.User role to their own users or groups."
  value       = (var.provision_entra_app && length(var.azure_ad_additional_allowed_tenant_ids) > 0) ? "For each tenant in azure_ad_additional_allowed_tenant_ids: an admin there must consent to app ${local.effective_entra_client}, then assign the SqlFlow.User role to their own users/groups in their own enterprise application view." : ""
}

output "control_plane_base_url" {
  description = "The API base URL: point CLI remotes (SQLFLOW_URL) and any external scheduler at this."
  value       = module.control_plane.control_plane_base_url
}

output "control_plane_identity_client_id" {
  description = "Client id of the control plane identity, for granting access to flow secrets beyond this vault."
  value       = module.control_plane.identity_client_id
}

output "worker_identity_client_id" {
  description = "Client id of the node identity, for granting access to the payload storage and the OSDU credentials its pool's flows use."
  value       = module.worker.identity_client_id
}

output "control_plane_identity_name" {
  description = "Name of the control plane identity: the database user it signs in as (db_owner of the metadata database, reader of each data database), granted inside every deployment on a server created here."
  value       = module.control_plane.identity_name
}

output "worker_identity_name" {
  description = "Name of the node identity: the database user it signs in as (the osdu schema only, and each data database as its sql_connections access says), granted inside every deployment on a server created here."
  value       = module.worker.identity_name
}

output "setup_identity_name" {
  description = "Name of the estate's setup identity: the SQL server's Entra administrator and the vault's secrets officer, which the deployment's own steps run as. No app runs as it."
  value       = azurerm_user_assigned_identity.setup.name
}

output "sql_authentication" {
  description = "How the apps sign in to SQL: entra (each app as its own managed identity) or password."
  value       = var.sql_authentication
}

output "sql_setup_script" {
  description = "With existing_sql_server under Entra authentication, the T-SQL an Entra administrator of that server runs, database by database, to create the apps' users (terraform output -raw sql_setup_script); every statement can run again. Empty otherwise: on a server created here the deployment grants them itself."
  value       = local.sql_setup_script
}

output "sql_server_fqdn" {
  description = "SQL server address (the connection strings are in Key Vault: osdu-delivery-catalog-db, osdu-delivery-osdu-db, and one per SQL connection)."
  value       = local.create_sql ? azurerm_mssql_server.this[0].fully_qualified_domain_name : var.existing_sql_server
}

output "sql_connections" {
  description = "The SQL connections every run is given, by the name a flow spells: the vault secret each is read from."
  value       = local.connection_secret_names
}

output "landing_url" {
  description = "The landing storage every run is given (landing_storage.reference_name), or empty without one."
  value       = local.landing_url
}

output "key_vault_name" {
  description = "The vault holding every estate secret: the generated ones, and the ones put here by hand (each partition's client secret, a repository's token or the GitHub App's private key, a connection elsewhere)."
  value       = azurerm_key_vault.this.name
}

output "github_app_private_key_secret" {
  description = "The vault secret the estate's GitHub App's private key is read from, put there by hand: az keyvault secret set --vault-name <key_vault_name> --name <this> --file <the App's .pem>. Null when the estate names no App."
  value       = var.github_app == null ? null : var.github_app.private_key_secret_name
}

output "key_vault_uri" {
  description = "The vault's URI."
  value       = azurerm_key_vault.this.vault_uri
}

output "ai_foundry_endpoint" {
  description = "The AI Foundry endpoint, or empty when ai_foundry_name was not set."
  value       = local.ai_foundry_enabled ? module.ai_foundry[0].endpoint : ""
}

output "ai_foundry_project_endpoint" {
  description = "The Foundry project endpoint the chat assistant connects to, or empty when ai_foundry_name was not set."
  value       = local.ai_foundry_endpoint
}

output "mcp_url" {
  description = "The MCP endpoint URL (register it in an editor or any remote MCP client with a SQLFlow token), or empty when mcp_image was not set."
  value       = local.mcp_enabled ? module.mcp[0].mcp_url : ""
}

output "chat_assistant_enabled" {
  description = "Whether the GUI chat assistant is on: the MCP server and a Foundry model are both deployed."
  value       = local.chat_assistant_on
}

output "osdu_partitions" {
  description = "The OSDU partitions the control plane registers when it starts: for each, whether it is the default and the vault secret its client secret is read from, which a person puts in the vault (the control plane reports one it cannot read yet as a failed start-up step)."
  value = {
    for id, p in var.osdu_partitions : id => {
      default            = p.default || length(var.osdu_partitions) == 1
      client_secret_name = local.partition_secret_names[id]
    }
  }
}
