{
  "name": "osdu-delivery",
  "displayName": "OSDU Delivery",
  "description": "Develop OSDU Delivery pipelines: every YAML document understood, the estate at hand, runs followed, and the assistant built in. Powered by SQLFlow.",
  "version": "1.0.0",
  "publisher": "business-iq",
  "license": "GPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TahirRiaz/osdu-delivery"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sqlflow-flow",
    "onLanguage:yaml",
    "workspaceContains:**/*.flow.yaml",
    "workspaceContains:**/schedules.yaml",
    "workspaceContains:**/mappings/*.yaml",
    "workspaceContains:**/osdu-delivery.yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "A workspace you have not trusted cannot choose the control plane your sign-in goes to, or the programs this extension runs.",
      "restrictedConfigurations": [
        "sqlflow.controlPlaneUrl",
        "sqlflow.guiUrl"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "sqlflow-flow",
        "aliases": [
          "OSDU Delivery document",
          "SQLFlow Flow",
          "flow.yaml"
        ],
        "extensions": [
          ".flow.yaml"
        ],
        "filenamePatterns": [
          "*.flow.yaml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/flow.svg",
          "dark": "./resources/flow.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sqlflow-flow",
        "scopeName": "source.sqlflow-flow",
        "path": "./syntaxes/sqlflow-flow.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "OSDU Delivery",
      "properties": {
        "sqlflow.controlPlaneUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the control plane. Empty uses the one the MCP server was last given."
        },
        "sqlflow.lspBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the sqlflow-lsp binary. Empty uses the bundled binary.",
          "scope": "machine"
        },
        "sqlflow.mcpBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the sqlflow-mcp binary. Empty uses the bundled binary.",
          "scope": "machine"
        },
        "sqlflow.runResultLimit": {
          "type": "number",
          "default": 50,
          "description": "How many runs to show in the Runs view."
        },
        "sqlflow.dataStreamWindowDays": {
          "type": "number",
          "default": 60,
          "description": "How many days of write history the Data Streams view analyses (1-180). A longer window gives the detectors a baseline behind the recent slice they judge."
        },
        "sqlflow.dataStreamShowHealthy": {
          "type": "boolean",
          "default": false,
          "description": "List every analysed stream in the Data Streams view, including the ones loading on pattern. Off by default: the view shows what needs attention and reports the rest as a count."
        },
        "sqlflow.guiUrl": {
          "type": "string",
          "default": "",
          "description": "Public base URL of the GUI, which makes links into it absolute so they open from here."
        },
        "sqlflow.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The sqlflow command line. Empty uses the one this extension carries, else sqlflow on the PATH."
        },
        "sqlflow.recognizeDocuments": {
          "type": "boolean",
          "default": true,
          "description": "Open a YAML file that is a pipeline document as one, judged by its content. Repositories hold their flows as plain *.yaml files."
        }
      }
    },
    "commands": [
      {
        "command": "sqlflow.signIn",
        "title": "Sign In with the Browser",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.signOut",
        "title": "Sign Out",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.setControlPlaneUrl",
        "title": "Set Control Plane URL",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.newFlow",
        "title": "New Document",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.validateFlow",
        "title": "Validate Document",
        "category": "OSDU Delivery",
        "icon": "$(check)"
      },
      {
        "command": "sqlflow.searchDocs",
        "title": "Search Docs",
        "category": "OSDU Delivery",
        "icon": "$(book)"
      },
      {
        "command": "sqlflow.openDocsForKey",
        "title": "Open Docs for Key Under Cursor",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.refreshCatalog",
        "title": "Refresh Catalog",
        "category": "OSDU Delivery",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.refreshRuns",
        "title": "Refresh Runs",
        "category": "OSDU Delivery",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.runFlow",
        "title": "Run Flow",
        "category": "OSDU Delivery",
        "icon": "$(play)"
      },
      {
        "command": "sqlflow.openPipeline",
        "title": "Open Flow",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.openRun",
        "title": "Open Run Detail",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.cancelRun",
        "title": "Cancel Run",
        "category": "OSDU Delivery",
        "icon": "$(stop)"
      },
      {
        "command": "sqlflow.runSchedule",
        "title": "Run Schedule Now",
        "category": "OSDU Delivery",
        "icon": "$(play)"
      },
      {
        "command": "sqlflow.showLineage",
        "title": "Show Run Order",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.refreshDataStreams",
        "title": "Refresh Data Streams",
        "category": "OSDU Delivery",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.openDataStream",
        "title": "Open Data Stream Analysis",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.setupMcp",
        "title": "Connect an AI Assistant",
        "category": "OSDU Delivery",
        "icon": "$(server)"
      },
      {
        "command": "sqlflow.signInWithToken",
        "title": "Sign In with an Access Token",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.validateRepository",
        "title": "Validate Repository",
        "category": "OSDU Delivery",
        "icon": "$(checklist)"
      },
      {
        "command": "sqlflow.runVerb",
        "title": "Run a Command Line Verb on This Document",
        "category": "OSDU Delivery",
        "icon": "$(terminal)"
      },
      {
        "command": "sqlflow.compareWithSynced",
        "title": "Compare with Synced",
        "category": "OSDU Delivery",
        "icon": "$(diff)"
      },
      {
        "command": "sqlflow.showFlowHistory",
        "title": "Show Flow History",
        "category": "OSDU Delivery",
        "icon": "$(history)"
      },
      {
        "command": "sqlflow.openInGui",
        "title": "Open in GUI",
        "category": "OSDU Delivery",
        "icon": "$(link-external)"
      },
      {
        "command": "sqlflow.syncRepository",
        "title": "Sync Repository",
        "category": "OSDU Delivery",
        "icon": "$(sync)"
      },
      {
        "command": "sqlflow.refreshRepository",
        "title": "Refresh Repository",
        "category": "OSDU Delivery",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.refreshDocument",
        "title": "Refresh Document View",
        "category": "OSDU Delivery",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.openFlowByName",
        "title": "Open Flow by Name",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.showStatus",
        "title": "Show Status",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.checkMapping",
        "title": "Check Mapping",
        "category": "OSDU Delivery",
        "icon": "$(checklist)"
      },
      {
        "command": "osduDelivery.scaffoldMapping",
        "title": "New Mapping from a Template",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.compareSchemaVersions",
        "title": "Compare Two Versions of a Kind",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.findRecord",
        "title": "Find a Record",
        "category": "OSDU Delivery",
        "icon": "$(search)"
      },
      {
        "command": "osduDelivery.probeTarget",
        "title": "Ask This Flow's OSDU Whether It Answers",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.showSchedulePlan",
        "title": "Show What a Schedule Runs",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.fetchTemplate",
        "title": "Fetch a Template into This Repository",
        "category": "OSDU Delivery"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlflow",
          "title": "OSDU Delivery",
          "icon": "./resources/flow.svg"
        }
      ]
    },
    "views": {
      "sqlflow": [
        {
          "id": "sqlflowDocument",
          "name": "Document"
        },
        {
          "id": "sqlflowRepository",
          "name": "Repository"
        },
        {
          "id": "osduDelivery",
          "name": "Delivery"
        },
        {
          "id": "sqlflowCatalog",
          "name": "Estate"
        },
        {
          "id": "sqlflowRuns",
          "name": "Runs"
        },
        {
          "id": "sqlflowSchedules",
          "name": "Schedules"
        },
        {
          "id": "sqlflowDataStreams",
          "name": "Data Streams"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sqlflow.openPipeline",
          "when": "false"
        },
        {
          "command": "sqlflow.openRun",
          "when": "false"
        },
        {
          "command": "sqlflow.cancelRun",
          "when": "false"
        },
        {
          "command": "sqlflow.runSchedule",
          "when": "false"
        },
        {
          "command": "sqlflow.openDataStream",
          "when": "false"
        },
        {
          "command": "sqlflow.openFlowByName",
          "when": "false"
        },
        {
          "command": "sqlflow.showStatus",
          "when": "false"
        },
        {
          "command": "sqlflow.showSchedulePlan",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sqlflow.refreshCatalog",
          "when": "view == sqlflowCatalog",
          "group": "navigation"
        },
        {
          "command": "sqlflow.searchDocs",
          "when": "view == sqlflowCatalog",
          "group": "navigation"
        },
        {
          "command": "sqlflow.refreshRuns",
          "when": "view == sqlflowRuns",
          "group": "navigation"
        },
        {
          "command": "sqlflow.refreshDataStreams",
          "when": "view == sqlflowDataStreams",
          "group": "navigation"
        },
        {
          "command": "sqlflow.refreshRepository",
          "when": "view == sqlflowRepository",
          "group": "navigation"
        },
        {
          "command": "sqlflow.validateRepository",
          "when": "view == sqlflowRepository",
          "group": "navigation"
        },
        {
          "command": "sqlflow.refreshDocument",
          "when": "view == sqlflowDocument",
          "group": "navigation"
        },
        {
          "command": "osduDelivery.findRecord",
          "when": "view == osduDelivery",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sqlflow.runFlow",
          "when": "view == sqlflowCatalog && viewItem == pipeline",
          "group": "inline"
        },
        {
          "command": "sqlflow.openPipeline",
          "when": "view == sqlflowCatalog && viewItem == pipeline"
        },
        {
          "command": "sqlflow.showLineage",
          "when": "view == sqlflowCatalog && viewItem =~ /^repo/"
        },
        {
          "command": "sqlflow.cancelRun",
          "when": "view == sqlflowRuns && viewItem == run-active",
          "group": "inline"
        },
        {
          "command": "sqlflow.openRun",
          "when": "view == sqlflowRuns && viewItem =~ /^run/"
        },
        {
          "command": "sqlflow.runSchedule",
          "when": "view == sqlflowSchedules && viewItem == schedule",
          "group": "inline"
        },
        {
          "command": "sqlflow.openDataStream",
          "when": "view == sqlflowDataStreams && viewItem == datastream"
        },
        {
          "command": "sqlflow.syncRepository",
          "when": "view == sqlflowCatalog && viewItem == repo-synced",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "sqlflow.validateFlow",
          "when": "resourceLangId == sqlflow-flow",
          "group": "navigation"
        },
        {
          "command": "sqlflow.runFlow",
          "when": "resourceLangId == sqlflow-flow",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "sqlflow.openDocsForKey",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.compareWithSynced",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.showFlowHistory",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.openInGui",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.runVerb",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "osduDelivery.mcp",
        "label": "OSDU Delivery"
      }
    ],
    "viewsWelcome": [
      {
        "view": "sqlflowCatalog",
        "contents": "Sign in to read the estate.\n[Sign In with the Browser](command:sqlflow.signIn)",
        "when": "!sqlflow.signedIn"
      }
    ],
    "taskDefinitions": [
      {
        "type": "sqlflow",
        "required": [
          "verb",
          "file"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "description": "The command line verb."
          },
          "file": {
            "type": "string",
            "description": "The document it runs on."
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "osduDelivery.start",
        "title": "Develop pipelines with OSDU Delivery",
        "description": "From sign-in to a first checked document.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in with Microsoft",
            "description": "Your browser opens the GUI, you sign in as you always do and approve the code. The editor and its assistants share the sign-in.\n[Sign In](command:sqlflow.signIn)",
            "completionEvents": [
              "onContext:sqlflow.signedIn"
            ],
            "media": {
              "markdown": "resources/walkthrough/sign-in.md"
            }
          },
          {
            "id": "open",
            "title": "Open a repository",
            "description": "Flows, mappings, templates and schedules are recognised by what they hold, so a repository works as it is.\n[Validate Repository](command:sqlflow.validateRepository)",
            "completionEvents": [
              "onCommand:sqlflow.validateRepository"
            ],
            "media": {
              "markdown": "resources/walkthrough/repository.md"
            }
          },
          {
            "id": "assistant",
            "title": "Ask an assistant",
            "description": "The chat in this editor already has the estate's tools. Connect Claude Code, Cursor or Codex to the same server.\n[Connect an AI Assistant](command:sqlflow.setupMcp)",
            "completionEvents": [
              "onCommand:sqlflow.setupMcp"
            ],
            "media": {
              "markdown": "resources/walkthrough/assistant.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "node --test \"test/*.test.ts\"",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "npm run compile && npm run publish:cli && vsce package --no-dependencies",
    "test:integration": "node test/integration/runTest.mjs",
    "publish:cli": "dotnet publish ../SqlFlow.Delivery.Cli.Host/SqlFlow.Delivery.Cli.Host.csproj -c Release --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -m:1 -o publish/cli"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
