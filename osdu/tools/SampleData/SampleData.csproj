<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SqlFlow.Delivery.Tools.SampleData</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Description>Generates the sample estate's synthetic data: the well log CSV files the pre-ingestion flows read, the parquet payload chunks the delivery streams, and the lookup tables the sample mapping translates through. Deterministic for a seed; no network, no credentials.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlFlow.Delivery\SqlFlow.Delivery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One definition of the sample data's files, shared with the suites that read them back and check that the committed
         files are what this generator writes. -->
    <Compile Include="..\..\tests\SqlFlow.Delivery.Tests\SampleWellLogs.cs" Link="SampleWellLogs.cs" />
    <Compile Include="..\..\tests\SqlFlow.Delivery.Tests\PandasMetadata.cs" Link="PandasMetadata.cs" />
  </ItemGroup>

</Project>
