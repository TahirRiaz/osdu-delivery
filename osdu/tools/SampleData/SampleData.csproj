<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SqlFlow.Delivery.Tools.SampleData</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Description>Writes the sample estate's data files: the CSV files the pre-ingestion flows read, and the parquet payload chunks the delivery streams.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlFlow.Delivery\SqlFlow.Delivery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One definition of the sample data, shared with the suites that regenerate and check it. -->
    <Compile Include="..\..\tests\SqlFlow.Delivery.Tests\SampleWellLogs.cs" Link="SampleWellLogs.cs" />
  </ItemGroup>

</Project>
