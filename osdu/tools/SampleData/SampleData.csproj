<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SqlFlow.Delivery.Tools.SampleData</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Description>Exports the sample estate's data from the Recall tables in Databricks: the CSV files the pre-ingestion flows read, and the parquet payload chunks the delivery streams.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlFlow.Delivery\SqlFlow.Delivery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One definition of the sample data, shared with the suites that read it back. -->
    <Compile Include="..\..\tests\SqlFlow.Delivery.Tests\SampleWellLogs.cs" Link="SampleWellLogs.cs" />
    <Compile Include="..\..\tests\SqlFlow.Delivery.Tests\PandasMetadata.cs" Link="PandasMetadata.cs" />
    <None Update="queries\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
