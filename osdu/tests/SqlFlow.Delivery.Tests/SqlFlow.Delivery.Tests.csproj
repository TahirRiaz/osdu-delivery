<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- The ledger suites run the module's model on an in-memory SQLite database, so the ledger's semantics are
         exercised on every machine; the SQL Server suites cover the provider itself. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Core\SqlFlow.Core.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Catalog\SqlFlow.Catalog.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Sources\SqlFlow.Sources.csproj" />
    <!-- The chain suite asserts that lineage orders the estate's waves pre, then ingestion, then the OSDU flow, which is
         what the flow set collector and the graph builder decide. -->
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Lineage\SqlFlow.Lineage.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Delivery\SqlFlow.Delivery.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Delivery.Data\SqlFlow.Delivery.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample estate (flows, the cache flow, mappings, the schemas its templates are saved from, and the sample cache
         records) is linked into the test output as-is. -->
    <Content Include="..\..\samples\recall-welllog\mappings\**" Link="samples\mappings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\recall-welllog\templates\**" Link="samples\templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\recall-welllog\caches\**" Link="samples\caches\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\recall-welllog\flows\**" Link="samples\flows\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\recall-welllog\references\**" Link="samples\references\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sample data the pre-ingestion flows read and the payload files the delivery streams, so a suite can check
         the committed estate against what the fixture regenerates. -->
    <Content Include="..\..\samples\recall-welllog\data\**" Link="samples\data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The schemas the suites save beside the sample estate's, for the cases it does not carry (Fixtures/templates/README.md). -->
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
