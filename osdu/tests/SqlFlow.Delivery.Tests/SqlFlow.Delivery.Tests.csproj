<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- The ledger suites run the module's model on an in-memory SQLite database, so the ledger's semantics are
         exercised on every machine; the SQL Server suites cover the provider itself. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- The fake S3 store checks every SigV4 signature the route makes with the AWS SDK's own signer (AWSSDK.Core, at the
         AWSSDK.S3 version SQLFlow pins), so the route's signing is proven against AWS's implementation and not against
         itself. Tests only. -->
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Core\SqlFlow.Core.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Catalog\SqlFlow.Catalog.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Sources\SqlFlow.Sources.csproj" />
    <!-- The chain suite asserts that lineage orders the estate's waves pre, then ingestion, then the OSDU flow, which is
         what the flow set collector and the graph builder decide. -->
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Lineage\SqlFlow.Lineage.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Delivery\SqlFlow.Delivery.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Delivery.Data\SqlFlow.Delivery.Data.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Delivery.Telemetry\SqlFlow.Delivery.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample estate, linked into the test output in the shape the repository holds it: one folder for the source,
         holding its flows, the mappings they pin, and the cache flow with the folder of sample records beside it. The
         bundled schemas sit beside that folder rather than inside it, because a template is a catalog object captured
         from OSDU's schema service, not a file a repository sync reads. -->
    <Content Include="..\..\samples\wells\mappings\**" Link="samples\wells\mappings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\wells\cache\**" Link="samples\wells\cache\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\wells\flows\**" Link="samples\wells\flows\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\templates\**" Link="samples\templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\cache-records\**" Link="samples\cache-records\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The source's drop-off folder: what the pre-ingestion flows read and the payload files the delivery streams, so
         a suite can check the committed estate against what the fixture regenerates. -->
    <Content Include="..\..\samples\wells\data\**" Link="samples\wells\data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The pinned OSDU contracts every route test checks its requests against. -->
    <Content Include="..\..\specs\**" Link="specs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The schemas the suites save beside the sample estate's, for the cases it does not carry (Fixtures/templates/README.md). -->
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
