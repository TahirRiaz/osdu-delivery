<Project>

  <!-- Central package versions: SQLFlow's pins apply unchanged (a module never runs a different version of a library
       SQLFlow loads in the same process), and only the packages the module uses that SQLFlow does not are added here. -->
  <Import Project="$(MSBuildThisFileDirectory)..\sqlflow\Directory.Packages.props" />

  <ItemGroup>
    <!-- Where the module's metrics go, when a deployment turns the export on (osdu/docs/operations.md, "Metrics").
         OTLP is the standard protocol and reaches any backend that speaks it, Azure Monitor is what this product's own
         deployment runs on, and the console is for watching a node. The OpenTelemetry packages are the project's own
         (Apache-2.0); the Azure exporter is Microsoft's (MIT). Nothing is exported unless the deployment says so, and
         the exporters load only in the hosts. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
  </ItemGroup>

</Project>
