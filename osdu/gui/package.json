{
  "name": "osdu-delivery-gui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The OSDU Delivery GUI: SQLFlow's control plane GUI, compiled from the vendored tree, with the OSDU Delivery module installed.",
  "workspaces": [
    "lint"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "e2e": "playwright test --tsconfig tsconfig.node.json",
    "e2e:headed": "playwright test --tsconfig tsconfig.node.json --headed",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "node --test \"unit/**/*.test.ts\""
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.32",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@azure/msal-browser": "^5.28.0",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-table": "^9.3.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.18.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "hyparquet": "^1.32.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "minimatch": "^11.0.8",
    "osdu-delivery-gui-lint": {
      "typescript": "~6.0.3"
    }
  }
}
