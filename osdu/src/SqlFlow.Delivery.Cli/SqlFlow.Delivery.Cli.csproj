<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Delivery.Cli</RootNamespace>
    <Description>The OSDU module as SQLFlow's CLI composes it: the module's flow kinds on every command and worker node, and its own verbs (check, preview, values, records, config, partition, cache, template, assertions, dimensions, inventory).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The suites run the verbs over a command of their own (ModuleCommand), without SQLFlow's internal verb runner. -->
    <InternalsVisibleTo Include="SqlFlow.Delivery.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Cli\SqlFlow.Cli.csproj" />
    <ProjectReference Include="..\SqlFlow.Delivery\SqlFlow.Delivery.csproj" />
    <ProjectReference Include="..\SqlFlow.Delivery.Telemetry\SqlFlow.Delivery.Telemetry.csproj" />
    <ProjectReference Include="..\SqlFlow.Delivery.Data\SqlFlow.Delivery.Data.csproj" />
  </ItemGroup>

</Project>
