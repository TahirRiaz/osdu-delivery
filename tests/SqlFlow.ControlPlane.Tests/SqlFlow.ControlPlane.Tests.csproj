<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlFlow.ControlPlane\SqlFlow.ControlPlane.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Catalog\SqlFlow.Catalog.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Cli\SqlFlow.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one CLI child-process harness, shared with the engine suite so there is a single code path. -->
    <Compile Include="..\SqlFlow.Core.Tests\Integration\CliBinary.cs" Link="CliBinary.cs" />
    <!-- The one test-only document kind, shared with the engine suite so every platform test parses the same way. -->
    <Compile Include="..\SqlFlow.Core.Tests\TestFlowKind.cs" Link="TestFlowKind.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample delivery estate, so a platform test can execute a run of the one production flow kind: the flow,
         what it renders with, and the drop it renders from. Copied next to the binaries rather than located up the
         tree, so the suite works wherever the build output lands. -->
    <Content Include="..\..\samples\recall-welllog\flows\**" Link="samples\flows\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\recall-welllog\mappings\**" Link="samples\mappings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\recall-welllog\snapshots\**" Link="samples\snapshots\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\recall-welllog\references\**" Link="samples\references\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\recall-welllog\out\**" Link="samples\out\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
