{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "5955905144741735192"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. Defaults to the resource group location."
      }
    },
    "name": {
      "type": "string",
      "defaultValue": "sqlflow-control-plane",
      "metadata": {
        "description": "Name of the Container App (and the prefix for its managed identity)."
      }
    },
    "managedEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Resource id of an existing Container Apps managed environment to host the app."
      }
    },
    "image": {
      "type": "string",
      "metadata": {
        "description": "Container image reference, e.g. myregistry.azurecr.io/sqlflow-control-plane:latest"
      }
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Name of an existing Key Vault holding the catalog connection and JWT signing key secrets."
      }
    },
    "catalogConnectionSecretName": {
      "type": "string",
      "defaultValue": "sqlflow-catalog-db",
      "metadata": {
        "description": "Key Vault secret name for the catalog ADO.NET connection string."
      }
    },
    "jwtSigningKeySecretName": {
      "type": "string",
      "defaultValue": "sqlflow-jwt-signing-key",
      "metadata": {
        "description": "Key Vault secret name for the JWT signing key (must decode to at least 32 bytes)."
      }
    },
    "jwtIssuer": {
      "type": "string",
      "defaultValue": "sqlflow-control-plane",
      "metadata": {
        "description": "JWT issuer the control plane validates."
      }
    },
    "jwtAudience": {
      "type": "string",
      "defaultValue": "sqlflow",
      "metadata": {
        "description": "JWT audience the control plane validates."
      }
    },
    "acrLoginServer": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "ACR login server for managed-identity image pull (leave blank for a public registry)."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "Minimum replicas. Keep at 1 so the API is warm (a trigger never waits on a cold start)."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 3,
      "metadata": {
        "description": "Maximum replicas for ingress autoscale."
      }
    }
  },
  "variables": {
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-id', parameters('name'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name'))), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name'))))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto"
          },
          "registries": "[if(empty(parameters('acrLoginServer')), createArray(), createArray(createObject('server', parameters('acrLoginServer'), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name'))))))]",
          "secrets": [
            {
              "name": "catalog-db",
              "keyVaultUrl": "[format('{0}secrets/{1}', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri, parameters('catalogConnectionSecretName'))]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name')))]"
            },
            {
              "name": "jwt-signing-key",
              "keyVaultUrl": "[format('{0}secrets/{1}', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri, parameters('jwtSigningKeySecretName'))]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name')))]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "control-plane",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "env": [
                {
                  "name": "SQLFLOW_CATALOG_DB",
                  "secretRef": "catalog-db"
                },
                {
                  "name": "SQLFLOW_AZURE_AUTH",
                  "value": "mi"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name'))), '2023-01-31').clientId]"
                },
                {
                  "name": "ControlPlane__Jwt__SigningKey",
                  "secretRef": "jwt-signing-key"
                },
                {
                  "name": "ControlPlane__Jwt__Issuer",
                  "value": "[parameters('jwtIssuer')]"
                },
                {
                  "name": "ControlPlane__Jwt__Audience",
                  "value": "[parameters('jwtAudience')]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8080
                  },
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8080
                  },
                  "periodSeconds": 30
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name')))]"
      ]
    }
  ],
  "outputs": {
    "controlPlaneBaseUrl": {
      "type": "string",
      "metadata": {
        "description": "The control plane base URL to give the ADF pipeline as controlPlaneBaseUrl."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('name')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "identityClientId": {
      "type": "string",
      "metadata": {
        "description": "The client id of the app identity (grant it db_datareader/writer on the catalog + access to flow secrets)."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id', parameters('name'))), '2023-01-31').clientId]"
    }
  }
}