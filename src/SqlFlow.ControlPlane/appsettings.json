{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "Catalog": {
      "ConnectionReference": "${env:SQLFLOW_CATALOG_DB}"
    },
    "Jwt": {
      "Issuer": "sqlflow-control-plane",
      "Audience": "sqlflow",
      "AccessTokenMinutes": 60
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "RateLimit": {
      "PermitPerWindow": 120,
      "WindowSeconds": 60
    }
  }
}
