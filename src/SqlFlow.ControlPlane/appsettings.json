{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "Catalog": {
      "ConnectionReference": "${env:SQLFLOW_CATALOG_DB}"
    },
    "Jwt": {
      "Issuer": "sqlflow-control-plane",
      "Audience": "sqlflow",
      "AccessTokenMinutes": 60
    },
    "AzureAd": {
      "Enabled": false,
      "TenantId": null,
      "ClientId": null,
      "DefaultRole": "viewer"
    },
    "Bootstrap": {
      "ApplyMigrations": true,
      "AdminUsername": null,
      "AdminPasswordReference": null
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Proxy": {
      "Enabled": false,
      "KnownNetworks": [],
      "KnownProxies": [],
      "ForwardLimit": 1
    },
    "Worker": {
      "Enabled": true,
      "Pools": []
    },
    "RateLimit": {
      "PermitPerWindow": 120,
      "WindowSeconds": 60
    }
  }
}
