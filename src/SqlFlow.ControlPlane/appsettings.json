{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "Catalog": {
      "ConnectionReference": "${env:SQLFLOW_CATALOG_DB}"
    },
    "Jwt": {
      "_comment": "AccessTokenMinutes is one token's life, not the user's: a signed-in GUI rolls its token before it lapses (POST /auth/renew), so this bounds how long a leaked token keeps working. SessionMaxDays is the absolute ceiling on that rolling, measured from the actual sign-in.",
      "Issuer": "sqlflow-control-plane",
      "Audience": "sqlflow",
      "AccessTokenMinutes": 720,
      "SessionMaxDays": 30
    },
    "AzureAd": {
      "_comment": "Entra single sign-on turns on automatically once TenantId and ClientId are set (in this file, an appsettings.Development/Production overlay, or ControlPlane__AzureAd__* environment variables). Local username/password sign-in is always available alongside it. Set Enabled to true to require SSO, or false to force it off even when credentials are present.",
      "TenantId": null,
      "ClientId": null,
      "DefaultRole": "viewer"
    },
    "Bootstrap": {
      "ApplyMigrations": true,
      "AdminUsername": null,
      "AdminPasswordReference": null
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Proxy": {
      "Enabled": false,
      "KnownNetworks": [],
      "KnownProxies": [],
      "ForwardLimit": 1
    },
    "Worker": {
      "Enabled": true,
      "Pools": []
    },
    "RateLimit": {
      "PermitPerWindow": 120,
      "WindowSeconds": 60
    },
    "Notifications": {
      "Enabled": true,
      "PollSeconds": 30,
      "GuiBaseUrl": null,
      "Email": {
        "Provider": "none",
        "FromAddress": null,
        "FromDisplayName": "SQLFlow",
        "Smtp": {
          "Host": null,
          "Port": 587,
          "SslMode": "starttls",
          "UsernameReference": null,
          "PasswordReference": null
        },
        "Graph": {
          "SenderId": null,
          "TenantId": null,
          "ClientId": null,
          "ClientSecretReference": null
        }
      },
      "Slack": {
        "BotTokenReference": null
      }
    }
  }
}
