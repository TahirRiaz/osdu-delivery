<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Acquire</RootNamespace>
    <Description>Generic third-party API acquisition engine (flowType: acq): auth, request templating, pagination, fan-out iteration, retry/rate-limit/SSRF guarding, and raw-format landing to the data lake across HTTP, SFTP, S3, and Azure Table transports.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlFlow.Core\SqlFlow.Core.csproj" />
    <ProjectReference Include="..\SqlFlow.Azure\SqlFlow.Azure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlFlow.Acquire.Tests" />
  </ItemGroup>

</Project>
