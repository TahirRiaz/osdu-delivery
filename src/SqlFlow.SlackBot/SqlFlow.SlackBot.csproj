<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SqlFlow.SlackBot</RootNamespace>
    <Description>The Slack front end for the SQLFlow assistant: a Socket Mode worker that relays channel mentions and DMs to a model provider whose tools are the SQLFlow MCP server (HTTP mode), and posts the answers back into the Slack thread. Three provider modes share one experience: Azure AI Foundry (managed identity), the OpenAI platform (API key), or the Anthropic Claude API (API key). Holds one read-scoped SQLFlow access token that rides along as the MCP Authorization header on every agent run; the control plane enforces scopes exactly as it does for any other client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SlackNet" />
    <PackageReference Include="Azure.Identity" />
    <!-- The official Anthropic SDK, used by the Anthropic provider mode (Messages API + MCP connector). -->
    <PackageReference Include="Anthropic" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single code path for Azure auth: the same credential factory the engine uses for Key Vault and
         ADF/Automation also signs this service into the Foundry project (managed identity in Azure,
         az login on a dev box). -->
    <ProjectReference Include="..\SqlFlow.Azure\SqlFlow.Azure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlFlow.SlackBot.Tests" />
  </ItemGroup>

</Project>
