<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Providers</RootNamespace>
    <Description>Non-SQL-Server source providers: MySQL (MySqlConnector) and PostgreSQL (Npgsql) connection factories, canonicalizers, catalog readers, SQL dialects, and type mappers. Sources only; the target is always SQL Server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlFlow.Core\SqlFlow.Core.csproj" />
  </ItemGroup>

</Project>
