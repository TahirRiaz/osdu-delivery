<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Catalog</RootNamespace>
    <Description>The EF-managed catalog: the read model of the git/YAML flow estate, the run queue, schedules, nodes, users, notifications, and the delivery ledger. Entity Framework lives ONLY in this assembly.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- PasswordHasher (PBKDF2) for local users: the one hashing implementation shared by the control
         plane (via DI) and the CLI's offline 'user' command, so a CLI-set hash verifies at login unchanged. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <!-- Cronos: DST-aware cron parsing for the schedule clock (the scheduling domain - table, store, clock - lives here). -->
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlFlow.Core\SqlFlow.Core.csproj" />
    <ProjectReference Include="..\SqlFlow.Yaml\SqlFlow.Yaml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlFlow.Core.Tests" />
  </ItemGroup>

</Project>
